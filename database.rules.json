{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",

        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",

        ".validate": "newData.hasChildren(['uid', 'email', 'role']) && newData.child('uid').val() === $uid && newData.child('role').val() !== 'admin'"
      }
    },

    "locations": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",

        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",

        ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'latitude', 'longitude', 'accuracy', 'timestamp']) && newData.child('uid').val() === $uid)"
      }
    }
  }
}
